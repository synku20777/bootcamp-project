# Connector identifier from Snowsight account details: organization-account.
# Do not use a URL, https:// prefix, region hostname, or snowflakecomputing.com.
SNOWFLAKE_ACCOUNT=your_organization-your_account
SNOWFLAKE_USER=your_username
SNOWFLAKE_PASSWORD=your_password
# ACCOUNTADMIN is used only for account objects and initial role grants.
SNOWFLAKE_BOOTSTRAP_ROLE=ACCOUNTADMIN
# Deployment role for schemas, transformations, and reporting objects.
SNOWFLAKE_ROLE=COVID_PROJECT_ADMIN
# Least-privilege runtime role used by FastAPI. Do not use ACCOUNTADMIN here.
SNOWFLAKE_API_ROLE=COVID_APP_ROLE
SNOWFLAKE_WAREHOUSE=COVID_WH
SNOWFLAKE_DATABASE=COVID_ANALYTICS
SNOWFLAKE_SCHEMA=RAW
SNOWFLAKE_API_SCHEMA=MARTS
# Default promotion target. Set to legacy and restart the API for rollback.
COVID_DATASET=extended

# Local Docker MongoDB credentials; unrelated to Snowflake credentials.
MONGO_ROOT_USERNAME=covid_admin
MONGO_ROOT_PASSWORD=replace_with_alphanumeric_password
MONGO_DATABASE=covid_app
# Host-side URI. Compose supplies the service hostname to the API container.
MONGODB_URI=mongodb://covid_admin:replace_with_alphanumeric_password@localhost:27017/covid_app?authSource=admin
# Host-side URI. Compose overrides localhost with redis inside the API container.
REDIS_URL=redis://localhost:6379/0

CACHE_ENABLED=true
CACHE_NAMESPACE=covid-api:v4
WORLD_BANK_MANIFEST_PATH=data/external/world_bank_indicators_2019_2021.manifest.json
CACHE_TTL_COUNTRIES_SECONDS=86400
CACHE_TTL_OVERVIEW_SECONDS=86400
CACHE_TTL_SUMMARY_SECONDS=86400
CACHE_TTL_TIMESERIES_SECONDS=86400
CACHE_TTL_COMPARE_SECONDS=86400
CACHE_TTL_FORECAST_SECONDS=21600
CACHE_TTL_COUNTRY_PAGE_SECONDS=86400
CACHE_TTL_COMPARISON_PAGE_SECONDS=86400
CACHE_TTL_ANNOTATION_TARGET_SECONDS=86400
CACHE_LOCK_SECONDS=30
CACHE_LOCK_WAIT_SECONDS=10
CACHE_LOCK_POLL_SECONDS=0.1

# Host-side defaults; Compose uses http://api:8000 inside the dashboard container.
DASHBOARD_API_BASE_URL=http://localhost:8000
DASHBOARD_PUBLIC_API_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO
SERVICE_NAME=covid-api
